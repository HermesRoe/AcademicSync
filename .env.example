# Choose one provider: openai (paid) or ollama (free, local)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# false = mock calendar (data/busy_mock.json). true = real Google Calendar (needs credentials.json)
USE_GCAL=true
